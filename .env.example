# Copy this file to .env and fill in real values.
#
# IMPORTANT: most of these are NOT prefixed VITE_. Vite only ships
# VITE_-prefixed variables to the browser — the unprefixed ones are
# read by the serverless functions in /api, which run on Vercel's
# servers, so those key values never reach the public website's
# JavaScript. The two Supabase ones ARE meant to be public (their
# "anon" key relies on database-level Row Level Security, not
# secrecy), so those two specifically use the VITE_ prefix on purpose.

# Steam Web API key — get one instantly (no approval wait) at:
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# PlatPrices API key (PlayStation Store prices) — apply at:
# https://platprices.com/api-request
PLATPRICES_KEY=

# XBXprices API key (Xbox/Microsoft Store prices) — apply at:
# https://xbxprices.com
XBXPRICES_KEY=

# RAWG (Upcoming Releases — new games and DLC/expansions across every
# platform, real official API) — free signup at rawg.io/apidocs.
# NOTE: their free tier requires attribution (a visible link back to
# RAWG wherever the data shows) — already built into the page, don't
# remove it if you're editing UpcomingReleasesPage.jsx.
RAWG_KEY=

# TMDB (Entertainment College — real movie/TV search and tracking) —
# free signup at themoviedb.org/signup, then Settings > API. Free for
# non-commercial use; their terms require displaying the TMDB logo
# specifically for attribution (a text-link placeholder is used for
# now until a real logo asset is added).
TMDB_API_KEY=

# UPCitemdb (Collectibles barcode scanning) — OPTIONAL. Works with no
# key at all via their keyless trial tier (100 lookups/day, shared
# across every Lykodex user since the lookup goes through our server).
# Only set this if you sign up for a paid plan at upcitemdb.com/api for
# a real per-account quota instead of the shared trial one.
UPC_LOOKUP_KEY=

# Xbox Live sign-in ("Sign in with Microsoft" -> real Gamerscore) —
# requires your own Azure app registration at portal.azure.com >
# "App registrations" > New registration. Redirect URI: add your app's
# own root URL (e.g. https://lykodex.vercel.app/ for prod, or
# http://localhost:5173/ for local dev) as a "Web" platform redirect
# URI, NOT "Single-page application" (this flow needs the client
# secret, exchanged server-side in api/pricing.js, not a public SPA
# flow). Client ID is public (ships to the browser); Client secret must
# stay here, unprefixed.
VITE_MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Daily Gaming Mastery recompute for everyone with Xbox/PSN linked
# (see vercel.json's cron + api/pricing.js's handleMasteryCron) — any
# random string works, it just has to match. Vercel automatically
# sends this as "Authorization: Bearer <value>" on the scheduled
# request; the endpoint refuses to run at all if this isn't set,
# rather than allow an unauthenticated public trigger.
CRON_SECRET=

# PlayStation Network trophy sync — NO signup needed. Sony has no
# public OAuth app registration path; linking uses a real npsso session
# token each person copies from their own browser (entered in-app, in
# Account Linking) rather than any credential set here.

# Supabase — real accounts + persistence. Create a free project at
# supabase.com, then Settings > API for these two values. Also run
# supabase/schema.sql once in the SQL Editor before this will work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service-role key — server only. Do NOT prefix this with VITE_; it
# must never reach the browser. Required for Xbox/PSN/Crunchyroll
# token storage and for the assistant's assistant_providers table
# (api/pricing.js). Supabase dashboard → Settings → API → service_role.
# Treat it like a master password. The assistant also needs the
# assistant_providers migration applied before it can store a key.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for packaged desktop (Tauri) / mobile (Capacitor) builds
# — leave blank for the normal website, where relative /api/ paths
# already work correctly. Once deployed, set this to the real URL,
# e.g. https://lykodex.vercel.app — see PACKAGING.md for why.
VITE_API_BASE_URL=

# --- Required ---
# Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Same Supabase project the Lykodex app uses (Settings > API)
SUPABASE_URL=https://zcwrlnljtfvslldwyldq.supabase.co
# service_role secret — bypasses RLS. Never put this anywhere client-facing.
SUPABASE_SERVICE_ROLE_KEY=

# --- Recommended while testing ---
# Your server ID (right-click server > Copy Server ID with
# Developer Mode on). When set, slash commands register to just this
# server and appear instantly. When blank they register globally,
# which can take up to an hour to show up.
DISCORD_GUILD_ID=

# --- Optional ---
# Lykodex site used for links and the /api/steam + /api/scryfall proxies
SITE_BASE_URL=https://lykodex.vercel.app
# Set to false to run this bot side-by-side with the OLD presence bot
# without double-counting console playtime (see README "Cutover").
ENABLE_PRESENCE_TRACKING=true
# Set to false to skip the daily Gaming + Overall Mastery refresh
ENABLE_MASTERY_REFRESH=true
# How often (seconds) the activity feed checks Lykodex for new events
FEED_POLL_SECONDS=60
